# Marionette environment template.
# Copy to .env and fill in. NEVER commit .env (it is gitignored + secret-scanned).

# --- LLM providers (Goal Compiler / replanner / judge) ---
# Kilo Code gateway (primary). Empty = anonymous free tier (kilo-auto/free, ~200 req/h per IP).
KILO_API_KEY=
# LLM7.io (keyless fallback) — any non-empty placeholder string works.
LLM7_API_KEY=placeholder
# NVIDIA NIM (last resort, OpenAI-compatible: https://integrate.api.nvidia.com/v1)
NVIDIA_API_KEY=

# --- GitHub (push access; consumed only by scripts/git-cred.sh, never persisted in git config) ---
GITHUB_TOKEN=

# --- Optional overrides ---
# MARIONETTE_STOCKFISH_PATH=vendor/stockfish/stockfish
# MARIONETTE_LLM_MODEL=kilo-auto/free
# MARIONETTE_HARNESS_CONCURRENCY=2
